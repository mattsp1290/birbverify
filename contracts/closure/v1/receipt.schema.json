{
  "$defs": {
    "Acquired": {
      "additionalProperties": false,
      "properties": {
        "attempt_id": {
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]{0,95}$",
          "title": "Attempt Id",
          "type": "string"
        },
        "kind": {
          "const": "acquired",
          "default": "acquired",
          "title": "Kind",
          "type": "string"
        },
        "reservation_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Reservation Sha256",
          "type": "string"
        }
      },
      "required": [
        "attempt_id",
        "reservation_sha256"
      ],
      "title": "Acquired",
      "type": "object"
    },
    "Cleanup": {
      "additionalProperties": false,
      "properties": {
        "no_op_reason": {
          "anyOf": [
            {
              "const": "never_acquired",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "No Op Reason"
        },
        "operation_id": {
          "$ref": "#/$defs/OperationId"
        },
        "payload_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Payload Sha256",
          "type": "string"
        },
        "procedure_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Procedure Sha256",
          "type": "string"
        },
        "result_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Result Sha256",
          "type": "string"
        },
        "status": {
          "const": "complete",
          "default": "complete",
          "title": "Status",
          "type": "string"
        }
      },
      "required": [
        "procedure_sha256",
        "operation_id",
        "payload_sha256",
        "result_sha256",
        "no_op_reason"
      ],
      "title": "Cleanup",
      "type": "object"
    },
    "ConfirmedStop": {
      "additionalProperties": false,
      "properties": {
        "checker_id": {
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]{0,95}$",
          "title": "Checker Id",
          "type": "string"
        },
        "evidence_refs": {
          "items": {
            "$ref": "#/$defs/EvidenceRef"
          },
          "minItems": 1,
          "title": "Evidence Refs",
          "type": "array"
        },
        "kind": {
          "const": "confirmed",
          "default": "confirmed",
          "title": "Kind",
          "type": "string"
        }
      },
      "required": [
        "checker_id",
        "evidence_refs"
      ],
      "title": "ConfirmedStop",
      "type": "object"
    },
    "EvidenceRef": {
      "additionalProperties": false,
      "properties": {
        "checker_id": {
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]{0,95}$",
          "title": "Checker Id",
          "type": "string"
        },
        "id": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Id",
          "type": "string"
        },
        "kind": {
          "enum": [
            "fence",
            "daemon",
            "stop",
            "registration",
            "restore"
          ],
          "title": "Kind",
          "type": "string"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        }
      },
      "required": [
        "id",
        "sha256",
        "kind",
        "checker_id"
      ],
      "title": "EvidenceRef",
      "type": "object"
    },
    "Fence": {
      "additionalProperties": false,
      "properties": {
        "commit_revision": {
          "exclusiveMinimum": 0,
          "title": "Commit Revision",
          "type": "integer"
        },
        "effect_history_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Effect History Sha256",
          "type": "string"
        },
        "evidence_ref": {
          "$ref": "#/$defs/EvidenceRef"
        },
        "operation_id": {
          "$ref": "#/$defs/OperationId"
        },
        "sealed_request_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sealed Request Sha256",
          "type": "string"
        }
      },
      "required": [
        "operation_id",
        "commit_revision",
        "sealed_request_sha256",
        "effect_history_sha256",
        "evidence_ref"
      ],
      "title": "Fence",
      "type": "object"
    },
    "MissingHistory": {
      "additionalProperties": false,
      "properties": {
        "manifest_sha256": {
          "default": null,
          "title": "Manifest Sha256",
          "type": "null"
        },
        "manifest_status": {
          "const": "unavailable",
          "default": "unavailable",
          "title": "Manifest Status",
          "type": "string"
        }
      },
      "title": "MissingHistory",
      "type": "object"
    },
    "NeverAcquired": {
      "additionalProperties": false,
      "properties": {
        "attempt_id": {
          "default": null,
          "title": "Attempt Id",
          "type": "null"
        },
        "kind": {
          "const": "never_acquired",
          "default": "never_acquired",
          "title": "Kind",
          "type": "string"
        },
        "reservation_sha256": {
          "default": null,
          "title": "Reservation Sha256",
          "type": "null"
        }
      },
      "title": "NeverAcquired",
      "type": "object"
    },
    "NotStarted": {
      "additionalProperties": false,
      "properties": {
        "evidence_refs": {
          "items": {
            "$ref": "#/$defs/EvidenceRef"
          },
          "minItems": 1,
          "title": "Evidence Refs",
          "type": "array"
        },
        "kind": {
          "const": "not_started_target_confirmed",
          "default": "not_started_target_confirmed",
          "title": "Kind",
          "type": "string"
        }
      },
      "required": [
        "evidence_refs"
      ],
      "title": "NotStarted",
      "type": "object"
    },
    "OperationId": {
      "additionalProperties": false,
      "properties": {
        "closure_id": {
          "format": "uuid",
          "title": "Closure Id",
          "type": "string"
        },
        "step": {
          "enum": [
            "fence",
            "stop",
            "cleanup",
            "release"
          ],
          "title": "Step",
          "type": "string"
        },
        "target_incarnation": {
          "format": "uuid",
          "title": "Target Incarnation",
          "type": "string"
        }
      },
      "required": [
        "target_incarnation",
        "closure_id",
        "step"
      ],
      "title": "OperationId",
      "type": "object"
    },
    "PresentHistory": {
      "additionalProperties": false,
      "properties": {
        "manifest_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Manifest Sha256",
          "type": "string"
        },
        "manifest_status": {
          "const": "present",
          "default": "present",
          "title": "Manifest Status",
          "type": "string"
        }
      },
      "required": [
        "manifest_sha256"
      ],
      "title": "PresentHistory",
      "type": "object"
    },
    "Release": {
      "additionalProperties": false,
      "properties": {
        "environment_revision": {
          "exclusiveMinimum": 0,
          "title": "Environment Revision",
          "type": "integer"
        },
        "operation_id": {
          "$ref": "#/$defs/OperationId"
        },
        "status": {
          "const": "release_confirmed",
          "default": "release_confirmed",
          "title": "Status",
          "type": "string"
        }
      },
      "required": [
        "operation_id",
        "environment_revision"
      ],
      "title": "Release",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "acquisition": {
      "discriminator": {
        "mapping": {
          "acquired": "#/$defs/Acquired",
          "never_acquired": "#/$defs/NeverAcquired"
        },
        "propertyName": "kind"
      },
      "oneOf": [
        {
          "$ref": "#/$defs/NeverAcquired"
        },
        {
          "$ref": "#/$defs/Acquired"
        }
      ],
      "title": "Acquisition"
    },
    "adapter_revision": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Adapter Revision",
      "type": "string"
    },
    "cleanup": {
      "$ref": "#/$defs/Cleanup"
    },
    "closure_actor": {
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]{0,95}$",
      "title": "Closure Actor",
      "type": "string"
    },
    "closure_id": {
      "format": "uuid",
      "title": "Closure Id",
      "type": "string"
    },
    "command_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Command Sha256",
      "type": "string"
    },
    "committed_at": {
      "format": "date-time",
      "title": "Committed At",
      "type": "string"
    },
    "contract_version": {
      "const": "birbverify.closure.v1",
      "default": "birbverify.closure.v1",
      "title": "Contract Version",
      "type": "string"
    },
    "execution_epoch": {
      "exclusiveMinimum": 0,
      "title": "Execution Epoch",
      "type": "integer"
    },
    "fence": {
      "$ref": "#/$defs/Fence"
    },
    "grant_reference": {
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]{0,95}$",
      "title": "Grant Reference",
      "type": "string"
    },
    "history": {
      "discriminator": {
        "mapping": {
          "present": "#/$defs/PresentHistory",
          "unavailable": "#/$defs/MissingHistory"
        },
        "propertyName": "manifest_status"
      },
      "oneOf": [
        {
          "$ref": "#/$defs/PresentHistory"
        },
        {
          "$ref": "#/$defs/MissingHistory"
        }
      ],
      "title": "History"
    },
    "idempotency_key": {
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]{0,95}$",
      "title": "Idempotency Key",
      "type": "string"
    },
    "policy_revision": {
      "pattern": "^[0-9a-f]{40}$",
      "title": "Policy Revision",
      "type": "string"
    },
    "producer_revision": {
      "pattern": "^[0-9a-f]{40}$",
      "title": "Producer Revision",
      "type": "string"
    },
    "receipt_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Receipt Sha256",
      "type": "string"
    },
    "release": {
      "$ref": "#/$defs/Release"
    },
    "request_id": {
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]{0,63}$",
      "title": "Request Id",
      "type": "string"
    },
    "request_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Request Sha256",
      "type": "string"
    },
    "stop": {
      "discriminator": {
        "mapping": {
          "confirmed": "#/$defs/ConfirmedStop",
          "not_started_target_confirmed": "#/$defs/NotStarted"
        },
        "propertyName": "kind"
      },
      "oneOf": [
        {
          "$ref": "#/$defs/NotStarted"
        },
        {
          "$ref": "#/$defs/ConfirmedStop"
        }
      ],
      "title": "Stop"
    },
    "target_id": {
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]{0,95}$",
      "title": "Target Id",
      "type": "string"
    },
    "target_incarnation": {
      "format": "uuid",
      "title": "Target Incarnation",
      "type": "string"
    }
  },
  "required": [
    "producer_revision",
    "adapter_revision",
    "closure_actor",
    "grant_reference",
    "policy_revision",
    "committed_at",
    "closure_id",
    "command_sha256",
    "request_id",
    "idempotency_key",
    "request_sha256",
    "target_id",
    "target_incarnation",
    "execution_epoch",
    "acquisition",
    "fence",
    "stop",
    "cleanup",
    "history",
    "release",
    "receipt_sha256"
  ],
  "title": "ClosureReceipt",
  "type": "object"
}
