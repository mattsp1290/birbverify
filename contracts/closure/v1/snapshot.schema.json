        "closure_id",
        "step"
      ],
      "title": "OperationId",
      "type": "object"
    },
    "PresentHistory": {
      "additionalProperties": false,
      "properties": {
        "manifest_sha256": {
          "pattern": "^[0-9a-f]{64}$",
