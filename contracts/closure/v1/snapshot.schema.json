    "Progress": {
      "additionalProperties": false,
      "properties": {
        "acquisition": {
          "discriminator": {
            "mapping": {
              "acquired": "#/$defs/Acquired",
              "acquired_provenance_unavailable": "#/$defs/AcquiredProvenanceUnavailable",
              "never_acquired": "#/$defs/NeverAcquired"
            },
            "propertyName": "kind"
          },
          "oneOf": [
            {
              "$ref": "#/$defs/NeverAcquired"
            },
            {
              "$ref": "#/$defs/Acquired"
            },
            {
              "$ref": "#/$defs/AcquiredProvenanceUnavailable"
            }
          ],
          "title": "Acquisition"
        },
        "blocking_reason": {
          "anyOf": [
            {
              "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]{0,95}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Blocking Reason"
        },
        "cleanup": {
          "anyOf": [
            {
              "$ref": "#/$defs/Cleanup"
            },
            {
              "type": "null"
            }
          ]
        },
        "closure_id": {
          "format": "uuid",
          "title": "Closure Id",
          "type": "string"
        },
        "execution_epoch": {
          "exclusiveMinimum": 0,
          "title": "Execution Epoch",
          "type": "integer"
        },
        "fence": {
          "$ref": "#/$defs/Fence"
        },
        "phase": {
          "enum": [
            "fenced_stop_unknown",
            "fenced_cleanup_unknown",
            "release_confirmed"
          ],
          "title": "Phase",
          "type": "string"
        },
        "receipt": {
          "anyOf": [
            {
              "$ref": "#/$defs/ClosureReceipt"
            },
            {
              "type": "null"
            }
          ]
        },
        "stop": {
          "anyOf": [
            {
              "discriminator": {
                "mapping": {
                  "confirmed": "#/$defs/ConfirmedStop",
                  "not_started_target_confirmed": "#/$defs/NotStarted"
                },
                "propertyName": "kind"
              },
              "oneOf": [
                {
                  "$ref": "#/$defs/NotStarted"
                },
                {
                  "$ref": "#/$defs/ConfirmedStop"
                }
              ]
            },
            {
              "type": "null"
            }
          ],
          "title": "Stop"
        }
      },
      "required": [
        "closure_id",
        "execution_epoch",
        "acquisition",
        "phase",
        "blocking_reason",
        "fence",
        "stop",
        "cleanup",
        "receipt"
      ],
      "title": "Progress",
      "type": "object"
