      "title": "Release",
      "type": "object"
    },
    "RequestObservation": {
      "additionalProperties": false,
      "properties": {
        "closure": {
          "anyOf": [
            {
              "$ref": "#/$defs/Progress"
            },
            {
              "type": "null"
            }
          ]
        },
        "execution_epoch": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Execution Epoch"
        },
        "manifest": {
          "anyOf": [
            {
              "$ref": "#/$defs/Manifest"
            },
            {
              "type": "null"
            }
          ]
        },
        "request_id": {
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]{0,63}$",
          "title": "Request Id",
          "type": "string"
        },
        "request_sha256": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Request Sha256"
        },
        "terminal": {
          "anyOf": [
            {
              "enum": [
                "verification",
                "closed_without_verification"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Terminal"
        }
      },
      "required": [
        "request_id",
        "request_sha256",
        "execution_epoch",
        "manifest",
        "closure",
        "terminal"
      ],
      "title": "RequestObservation",
      "type": "object"
    }
