          "type": "array"
        },
        "kind": {
          "const": "not_started_target_confirmed",
          "default": "not_started_target_confirmed",
          "title": "Kind",
          "type": "string"
        }
      },
      "required": [
        "evidence_refs"
      ],
      "title": "NotStarted",
      "type": "object"
    },
    "OperationId": {
      "additionalProperties": false,
      "properties": {
        "closure_id": {
          "format": "uuid",
