#!/usr/bin/env python3
import json
import os
import subprocess
import tempfile
from pathlib import Path

root = Path(tempfile.mkdtemp(prefix="birbverify-beans-")).resolve()
hub = root / "hub"
env = {
    "PATH": os.environ["PATH"],
    "HOME": str(root),
    "XDG_CONFIG_HOME": str(root / "config"),
    "GIT_CONFIG_GLOBAL": "/dev/null",
    "GIT_CONFIG_NOSYSTEM": "1",
    "GIT_AUTHOR_NAME": "Birbverify fixture",
    "GIT_AUTHOR_EMAIL": "fixture@localhost",
    "GIT_COMMITTER_NAME": "Birbverify fixture",
    "GIT_COMMITTER_EMAIL": "fixture@localhost",
}
subprocess.run(["git", "init", "-q", "-b", "main", str(hub)], env=env, check=True)
subprocess.run(
    ["git", "-C", str(hub), "commit", "--allow-empty", "-qm", "Fixture hub"], env=env, check=True
)


def bn(*args):
    assert hub.resolve().is_relative_to(root)
    assert not subprocess.check_output(["git", "-C", str(hub), "remote"], env=env).strip()
    return json.loads(
        subprocess.check_output(
            [
                "bn",
                "--hub",
                str(hub),
                "--branch",
                "main",
                "--project",
                "birbverify",
                "--actor",
                "birbverify-fixture",
                "--no-fetch",
                "--no-sync",
                "--json",
                *args,
            ],
            env=env,
            cwd=root,
        )
    )


bn("project", "create", "birbverify")
issue = bn(
    "create",
    "Prove immutable verification contract",
    "--description",
    "Synthetic fixture work record. No private hub or external effects.",
)
bn(
    "remember",
    "--key",
    "contract-proof",
    "All nine journeys require runtime evidence. Fixture evidence does not prove staging.",
)
handoff = root / "handoff.md"
handoff.write_text("# Fixture handoff\n\nContract test only. All records are synthetic.\n")
record = bn("handoff", "create", "Synthetic verification handoff", "--file", str(handoff))
notes = bn("memories", "--limit", "1")
assert notes[0]["key"] == "contract-proof"
assert not subprocess.check_output(
    ["git", "-C", str(hub), "status", "--porcelain"], env=env
).strip()
print(
    json.dumps(
        {
            "fixture_root": str(root),
            "issue": issue,
            "handoff": record,
            "commit": subprocess.check_output(
                ["git", "-C", str(hub), "rev-parse", "HEAD"], env=env, text=True
            ).strip(),
        }
    )
)
