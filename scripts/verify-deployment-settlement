#!/bin/sh
set -eu
cd "$(dirname "$0")/.."
umask 077
cluster="birbverify-bsmn-$(date +%s)-$$"
root="$PWD/.proof/bsmn/$cluster"
mkdir -p "$root/mailbox"
python3 fixtures/deployment_audit_pki.py "$root/pki" "$cluster-audit"
export BIRBVERIFY_SETTLEMENT_ROOT="$root"
export BIRBVERIFY_SETTLEMENT_CLUSTER="$cluster"
export BIRBVERIFY_SETTLEMENT_IMAGE="$cluster:fixture"
docker build -f fixtures/deployment.Dockerfile -t "$BIRBVERIFY_SETTLEMENT_IMAGE" .
cat > "$root/audit-policy.yaml" <<'POLICY'
apiVersion: audit.k8s.io/v1
kind: Policy
rules:
- level: RequestResponse
  verbs: [create]
  namespaces: [settlement-proof]
  resources:
  - group: apps
    resources: [deployments, replicasets]
  - group: ""
    resources: [pods]
  omitStages: [RequestReceived]
- level: None
POLICY
cat > "$root/kind.yaml" <<CONFIG
kind: Cluster
apiVersion: kind.x-k8s.io/v1alpha4
nodes:
- role: control-plane
  extraMounts:
  - hostPath: "$root/audit-policy.yaml"
    containerPath: /etc/kubernetes/audit-policy.yaml
    readOnly: true
  - hostPath: "$root/pki/webhook.kubeconfig"
    containerPath: /etc/kubernetes/audit-webhook.kubeconfig
    readOnly: true
  kubeadmConfigPatches:
  - |
    kind: ClusterConfiguration
    apiServer:
      extraArgs:
        audit-policy-file: /etc/kubernetes/audit-policy.yaml
        audit-webhook-config-file: /etc/kubernetes/audit-webhook.kubeconfig
        audit-webhook-mode: batch
        audit-webhook-version: audit.k8s.io/v1
        audit-webhook-batch-max-wait: 1s
        audit-webhook-initial-backoff: 1s
      extraVolumes:
      - name: audit-policy
        hostPath: /etc/kubernetes/audit-policy.yaml
        mountPath: /etc/kubernetes/audit-policy.yaml
        readOnly: true
        pathType: File
      - name: audit-webhook
        hostPath: /etc/kubernetes/audit-webhook.kubeconfig
        mountPath: /etc/kubernetes/audit-webhook.kubeconfig
        readOnly: true
        pathType: File
CONFIG
cleanup() {
    docker rm -f "$cluster-webhook" "$cluster-audit" >/dev/null 2>&1 || true
    kind delete cluster --name "$cluster" --kubeconfig "$root/kubeconfig"
}
trap cleanup EXIT INT TERM
kind create cluster --name "$cluster" --kubeconfig "$root/kubeconfig" \
    --config "$root/kind.yaml" \
    --image kindest/node:v1.33.1@sha256:050072256b9a903bd914c0b2866828150cb229cea0efe5892e2b644d5dd3b34f \
    --wait 90s
uv run pytest -q tests/test_deployment_settlement_journey.py --junitxml="$root/junit.xml"
printf 'Native controller settlement proof artifacts: %s\n' "$root"
