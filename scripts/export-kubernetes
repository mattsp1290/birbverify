#!/usr/bin/env python3
import json
from pathlib import Path

from birbverify.kubernetes_contract import (
    KubernetesInstallation,
    KubernetesReceipt,
    KubernetesRequest,
)
from birbverify.kubernetes_service import Command

root = Path(__file__).resolve().parents[1] / "contracts/kubernetes/v1"
root.mkdir(parents=True, exist_ok=True)
for name, model in (
    ("request", KubernetesRequest),
    ("receipt", KubernetesReceipt),
    ("installation", KubernetesInstallation),
    ("command", Command),
):
    (root / f"{name}.schema.json").write_text(
        json.dumps(model.model_json_schema(), indent=2, sort_keys=True) + "\n"
    )
